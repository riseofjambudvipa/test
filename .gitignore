# ==============================================================================
# CapStudio Enterprise Git Ignore (.gitignore)
# Comprehensive exclusion rules for Flutter multi-platform development.
# Targets: Windows, macOS, Linux, Android, iOS, and Web.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & System Junk
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
[Tt]humbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux & Desktop Environments
.directory
*~
*.swp
*.swo
*.bak
*.tmp
*.temp
.history/
.svn/
.buildlog/

# ------------------------------------------------------------------------------
# 2. IDEs & Code Editors
# ------------------------------------------------------------------------------
# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws
*.orig

# Visual Studio Code
.vscode/

# Visual Studio (Windows C++)
.vs/
*.suo
*.user
*.userosv
*.sln.docstates

# Eclipse / Xcode / Others
.project
.classpath
.settings/
DerivedData/
*.xcuserdatad
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
*.xcuserstate
*.xcodeproj/project.xcworkspace/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# ------------------------------------------------------------------------------
# 3. Flutter, Dart & Pub Dependencies
# ------------------------------------------------------------------------------
.dart_tool/
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
.packages
/build/
!scripts/build/
!third_party/scripts/build/
coverage/
doc/api/

# Obfuscation, Mapping & Symbolication Artifacts
debug-info/
app.*.symbols
app.*.map.json
*.symbols
*.map.json
*.dart.js.map

# ------------------------------------------------------------------------------
# 4. Android Platform
# ------------------------------------------------------------------------------
.gradle/
**/.gradle/
**/.kotlin/
**/android/.gradle/
**/android/.kotlin/
**/android/app/build/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/local.properties
**/android/key.properties
**/android/captures/
**/android/app/intermediates/
**/android/app/outputs/
**/android/app/extracted-include-protos/
**/android/bundle/
**/android/app/.cxx/
**/.cxx/
GeneratedPluginRegistrant.java
**/GeneratedPluginRegistrant.java

# Android Signing Keystores (NEVER COMMIT)
*.keystore
*.jks

# ------------------------------------------------------------------------------
# 5. iOS & macOS Ephemeral & Build Files
# ------------------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/App.xcframework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/ios/Flutter/GeneratedPluginRegistrant.*
**/macos/Flutter/GeneratedPluginRegistrant.*
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Runner/GeneratedPluginRegistrant.*
**/ios/.symlinks/
**/macos/.symlinks/
**/ios/Flutter/app.flx
**/ios/Flutter/flutter_assets/
Pods/
**/Pods/
Podfile.lock
ios/whisper_xcframework/
ios/Runner/whisper_xcframework/

# ------------------------------------------------------------------------------
# 6. Windows & Linux Build Artifacts
# ------------------------------------------------------------------------------
**/windows/flutter/ephemeral/
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake
**/linux/flutter/ephemeral/
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# Visual Studio / MSBuild Ephemeral & Intermediate Files
*.vcxproj.user
*.vcxproj.fileList
*.dir/
*.pdb
*.ilk
*.obj
*.exp
*.res
*.tlog
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# ------------------------------------------------------------------------------
# 7. Native Binaries & Libraries (Root & Project)
# ------------------------------------------------------------------------------
*.dll
*.so
*.dylib
*.a
*.exe
isar.dll
libisar.dll
android/app/src/main/jniLibs/
third_party/whisper.cpp/build*/
third_party/whisper.cpp/bin/

# ------------------------------------------------------------------------------
# 8. Code Signing Certificates & Keys (DO NOT COMMIT SECRETS)
# ------------------------------------------------------------------------------
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
scripts/certificate/windows/*.pfx
third_party/scripts/certificate/windows/*.pfx
.env
.env.*
!*.example.env

# ------------------------------------------------------------------------------
# 9. Temp Directories, Logs & Scratch Files
# ------------------------------------------------------------------------------
scratch/
test/.temp/
installer_resources/
logs/
*.log
__pycache__/
*.pyc

# ------------------------------------------------------------------------------
# 10. CapStudio App Assets & Heavy Download Bundles
# ------------------------------------------------------------------------------
# Native pre-compiled CLI binaries (downloaded on demand or via CI)
assets/bin/*.bin
assets/bin/*.bin.lzma
assets/bin/*.exe
assets/bin/ffmpeg
assets/bin/whisper-cli

# Downloadable Whisper AI models (Keep default tiny model tracked)
assets/models/*.bin
!assets/models/ggml-tiny.bin

# Downloadable Emoji Packs (zip archives & expanded folders)
assets/emojis/*.zip
assets/emojis/google_noto_emojis_animated_pack/
assets/emojis/google_noto_emojis_non_animated_pack/
assets/emojis/microsoft_fluentui_emoji_animated_pack/
assets/emojis/microsoft_fluentui_emoji_non_animated_pack/
assets/emojis/openmoji_non_animated_pack/

# Temporary processing assets
assets/temp/

# Large offline binary archives & asset pack bundles (Keep companion .sha256 tracked)
assets/archive/*.zip
assets/archive/*.tar.xz
assets/archive/*.tar.gz
!assets/archive/*.sha256

# ------------------------------------------------------------------------------
# 11. Output Release Artifacts & Distribution Packages
# ------------------------------------------------------------------------------
capstudio_*.deb
CapStudio-*.zip
CapStudio-*.tar.gz
*.AppImage
CapStudio.dmg
ios-runner.tar.gz
all_artifacts/
release_assets/
